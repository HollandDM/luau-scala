import mill._, scalalib._, scalajslib._, scalafmt._
import mill.scalajslib.api.{ModuleKind, JsEnvConfig}

val scalaVersion       = "3.8.3"
val scalaJSVersion     = "1.21.0"
val munitVersion       = "1.2.0"

trait LuauCrossPlatformModule extends ScalaModule with ScalafmtModule {
  def scalaVersion = build.scalaVersion
  def mvnDeps = platformDeps
  def platformDeps: Seq[Dep] = Seq.empty
  def scalacOptions = super.scalacOptions() ++ Seq(
    "-encoding", "UTF-8",
    "-deprecation", "-feature", "-unchecked",
    "-Xkind-projector:underscores",
    "-source:future",
    // Required on stable releases for `import language.experimental.captureChecking`
    // (capture checking itself stays per-file opt-in via that import).
    "-experimental",
    // SIP-66 `into` modifier (LuaArg conversions at call sites) is a preview
    // feature on 3.8.
    "-preview"
  )
}

trait LuauCrossPlatformJSModule extends LuauCrossPlatformModule with ScalaJSModule {
  def scalaJSVersion = build.scalaJSVersion
  def moduleKind = ModuleKind.CommonJSModule
}

object core extends Module {
  // jvm and js compile the same shared sources (core/src, tests in
  // core/test/src); the two modules exist only to emit JVM and Scala.js
  // artifacts. Platform-specific code, if ever needed, gets its own dir.
  object jvm extends LuauCrossPlatformModule {
    override def sources = Task.Sources(moduleDir / os.up / "src")
    object test extends ScalaTests with TestModule.Munit {
      override def sources = Task.Sources(moduleDir / os.up / os.up / "test" / "src")
      def mvnDeps = Seq(mvn"org.scalameta::munit::${build.munitVersion}")
    }
  }
  object js extends LuauCrossPlatformJSModule {
    override def sources = Task.Sources(moduleDir / os.up / "src")
    object test extends ScalaJSTests with TestModule.Munit {
      override def sources = Task.Sources(moduleDir / os.up / os.up / "test" / "src")
      def mvnDeps = Seq(mvn"org.scalameta::munit::${build.munitVersion}")
    }
  }
}

object panama extends LuauCrossPlatformModule {
  override def moduleDeps = super.moduleDeps ++ Seq(core.jvm, stdlib.jvm)
  object test extends ScalaTests with TestModule.Munit {
    def mvnDeps = Seq(mvn"org.scalameta::munit::${build.munitVersion}")
    override def moduleDeps = super.moduleDeps ++ Seq(core.jvm.test)
    override def forkArgs = Task {
      val lib = shim.nativeBuild()
      Seq(
        "--enable-native-access=ALL-UNNAMED",
        "--enable-preview",
        s"-Dluau.shim.lib=${lib.path}"
      )
    }
    override def forkEnv = Task {
      super.forkEnv() ++ Map(
        "LUAU_CONFORMANCE_DIR" -> (shim.moduleDir / "luau" / "tests" / "conformance").toString,
        // Luau's number lexing/printing goes through libc strtod/snprintf,
        // which honor LC_NUMERIC. A comma-decimal locale (vi_VN, de_DE, ...)
        // breaks parsing of literals like 3.14 inside the native Runtime.
        "LC_ALL" -> "C"
      )
    }
  }
}

object stdlib extends Module {
  object jvm extends LuauCrossPlatformModule {
    override def moduleDeps = super.moduleDeps ++ Seq(core.jvm, scheduler.jvm)
    override def sources = Task.Sources(moduleDir / os.up / "src", moduleDir / "src")
    object test extends ScalaTests with TestModule.Munit {
      override def sources = Task.Sources(moduleDir / os.up / os.up / "test" / "src")
      def mvnDeps = Seq(mvn"org.scalameta::munit::${build.munitVersion}")
    }
  }
  object js extends LuauCrossPlatformJSModule {
    override def moduleDeps = super.moduleDeps ++ Seq(core.js, scheduler.js)
    override def sources = Task.Sources(moduleDir / os.up / "src", moduleDir / "src")
    object test extends ScalaJSTests with TestModule.Munit {
      override def sources = Task.Sources(moduleDir / os.up / os.up / "test" / "src")
      def mvnDeps = Seq(mvn"org.scalameta::munit::${build.munitVersion}")
    }
  }
}

object scheduler extends Module {
  object jvm extends LuauCrossPlatformModule {
    override def moduleDeps = super.moduleDeps ++ Seq(core.jvm)
    override def sources = Task.Sources(moduleDir / os.up / "src", moduleDir / "src")
    object test extends ScalaTests with TestModule.Munit {
      override def sources = Task.Sources(moduleDir / os.up / os.up / "test" / "src")
      def mvnDeps = Seq(mvn"org.scalameta::munit::${build.munitVersion}")
    }
  }
  object js extends LuauCrossPlatformJSModule {
    override def moduleDeps = super.moduleDeps ++ Seq(core.js)
    override def sources = Task.Sources(moduleDir / os.up / "src", moduleDir / "src")
    object test extends ScalaJSTests with TestModule.Munit {
      override def sources = Task.Sources(moduleDir / os.up / os.up / "test" / "src")
      def mvnDeps = Seq(mvn"org.scalameta::munit::${build.munitVersion}")
    }
  }
}

object wasm extends LuauCrossPlatformJSModule {
  override def moduleDeps = super.moduleDeps ++ Seq(core.js, stdlib.js)
  override def jsEnvConfig = Task {
    val wasmDir = shim.wasmBuildNative()
    val wasmPath = wasmDir.path / "luau-shim.wasm"
    JsEnvConfig.NodeJs().copy(env = Map(
      "LUAU_WASM_PATH" -> wasmPath.toString,
      "LUAU_CONFORMANCE_DIR" -> (shim.moduleDir / "luau" / "tests" / "conformance").toString
    ))
  }
  object test extends ScalaJSTests with TestModule.Munit {
    def mvnDeps = Seq(mvn"org.scalameta::munit::${build.munitVersion}")
    override def moduleDeps = super.moduleDeps ++ Seq(core.js.test)
  }
}

object shim extends Module {

  // Mill 1.x sandboxes os.pwd inside tasks; moduleDir is this module's real
  // source directory (<repo>/shim).
  def shimSrcDir    = Task { moduleDir }
  def shimIncDir    = Task { moduleDir / "include" }
  // Content-tracked shim sources: editing lx.cpp/lx.h/build-wasm.sh must
  // invalidate nativeBuild and wasmBuildNative.
  def shimSources   = Task.Sources(
    moduleDir / "src",
    moduleDir / "include",
    moduleDir / "build-wasm.sh"
  )
  def luauIncVm     = Task { moduleDir / "luau" / "VM" / "include" }
  def luauIncCommon = Task { moduleDir / "luau" / "Common" / "include" }
  def luauIncCompiler = Task { moduleDir / "luau" / "Compiler" / "include" }
  def luauIncAst    = Task { moduleDir / "luau" / "Ast" / "include" }
  def luauIncBytecode = Task { moduleDir / "luau" / "Bytecode" / "include" }
  def luauVmDir     = Task { moduleDir / "luau" / "VM" }
  def luauCompilerDir = Task { moduleDir / "luau" / "Compiler" }
  def luauAstDir    = Task { moduleDir / "luau" / "Ast" }
  def luauBytecodeDir = Task { moduleDir / "luau" / "Bytecode" }
  def luauCommonDir = Task { moduleDir / "luau" / "Common" }

  def luauSubmoduleHead: Task[String] = Task.Input {
    val headFile = moduleDir / "luau" / ".git" / "HEAD"
    if (os.exists(headFile)) os.read(headFile).trim
    else "absent"
  }

  // Task.Input: listing the vendored submodule is an untracked read in Mill's
  // execution checker; Input tasks may read freely and re-evaluate per run.
  def luauSources: Task[Seq[os.Path]] = Task.Input {
    val dirs = Seq(
      moduleDir / "luau" / "VM",
      moduleDir / "luau" / "Compiler",
      moduleDir / "luau" / "Ast",
      moduleDir / "luau" / "Bytecode",
      moduleDir / "luau" / "Common"
    )
    dirs.flatMap { d =>
      val srcDir = d / "src"
      if (os.exists(srcDir)) os.list(srcDir).filter(_.ext == "cpp")
      else Seq.empty[os.Path]
    }
  }

  def allIncludeDirs: Task[Seq[String]] = Task {
    Seq(
      shimIncDir().toString, luauIncVm().toString, luauIncCommon().toString,
      luauIncCompiler().toString, luauIncAst().toString, luauIncBytecode().toString
    )
  }

  def nativePlatform: Task[(String, Seq[String])] = Task {
    val _     = luauSubmoduleHead()
    val osStr = System.getProperty("os.name", "").toLowerCase
    if (osStr.contains("mac")) ("dylib", Seq("-dynamiclib"))
    else                        ("so",    Seq("-shared", "-fPIC"))
  }

  def nativeBuild: Task[PathRef] = Task {
    val _           = shimSources()
    val dest        = Task.dest
    val (ext, lflags) = nativePlatform()
    val outLib      = dest / s"libluau-shim.$ext"
    val srcFile     = shimSrcDir() / "src" / "lx.cpp"
    val includeArgs = allIncludeDirs().flatMap(d => Seq("-I", d))
    val luauSrcs    = luauSources().map(_.toString)

    os.proc(Seq("clang++") ++
      Seq("-std=c++17", "-O2") ++ includeArgs ++ lflags ++
      Seq("-o", outLib.toString, srcFile.toString) ++ luauSrcs
    ).call(cwd = dest, stdout = os.Inherit, stderr = os.Inherit)

    PathRef(outLib)
  }

  def wasmBuild: Task[PathRef] = Task {
    val _       = luauSubmoduleHead()
    val dest    = Task.dest
    val outJs   = dest / "luau-shim.js"
    val srcFile   = shimSrcDir() / "src" / "lx.cpp"
    val includeArgs = allIncludeDirs().flatMap(d => Seq("-I", d))
    val luauSrcs  = luauSources().map(_.toString)

    val exportedFunctions = Seq(
      "_lx_newstate", "_lx_close", "_lx_new_thread",
      "_lx_thread_status", "_lx_compile_and_load", "_lx_resume",
      "_lx_push_nil", "_lx_push_boolean", "_lx_push_number", "_lx_push_integer",
      "_lx_push_lstring", "_lx_push_ref", "_lx_push_copy", "_lx_pop", "_lx_stack_top",
      "_lx_type", "_lx_to_number", "_lx_to_integer", "_lx_to_boolean", "_lx_to_lstring",
      "_lx_rawlen", "_lx_newtable", "_lx_rawget", "_lx_rawset", "_lx_rawgeti", "_lx_rawseti",
      "_lx_setarray", "_lx_table_next", "_lx_ref", "_lx_unref", "_lx_register_native",
      "_lx_set_suspend_token", "_lx_get_suspend_token",
      "_lx_set_global", "_lx_get_global",
      "_lx_openlibs", "_lx_sandbox",
      "_lx_gc_step", "_lx_gc_collect", "_lx_copy_error", "_lx_conformance_setup", "_lx_resume_error",
      "_malloc", "_free"
    ).mkString("[", ",", "]")
    val exportedRuntimeMethods = Seq(
      "addFunction", "removeFunction", "dynCall_iii", "dynCall_iiiiii",
      "ccall", "cwrap", "getValue", "setValue", "UTF8ToString", "stringToUTF8"
    ).mkString("[\"", "\",\"", "\"]")

    os.proc(Seq("emcc") ++
      Seq("-std=c++17", "-O2") ++ includeArgs ++
      Seq("-s", "WASM=1",
        "-s", s"EXPORTED_FUNCTIONS=$exportedFunctions",
        "-s", s"EXPORTED_RUNTIME_METHODS=$exportedRuntimeMethods",
        "-s", "MODULARIZE=1", "-s", "EXPORT_NAME='LuauShim'",
        "-s", "ALLOW_MEMORY_GROWTH=1", "-s", "ALLOW_TABLE_GROWTH=1",
        "-s", "STACK_SIZE=1048576", "-s", "ENVIRONMENT='node,web,worker'",
        "--no-entry", "-o", outJs.toString, srcFile.toString
      ) ++ luauSrcs
    ).call(cwd = dest, stdout = os.Inherit, stderr = os.Inherit)

    PathRef(dest / "luau-shim.wasm")
  }

  def wasmBuildNative = Task {
    val _ = luauSubmoduleHead()
    val _sources = shimSources()
    val script = moduleDir / "build-wasm.sh"
    os.proc("/usr/bin/bash", script.toString, Task.dest.toString).call(
      cwd = moduleDir / os.up,
      stdout = os.Inherit,
      stderr = os.Inherit
    )
    val wasmFile = Task.dest / "luau-shim.wasm"
    if !os.exists(wasmFile) then
      sys.error("WASM not produced at $wasmFile")
    PathRef(Task.dest)
  }
}
