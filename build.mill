    def ivyDeps    = T { Agg(ivy"org.typelevel::cats-effect::${catsEffectVersion}") }
    def sources    = T.sources { millSourcePath / os.up / "jvm" / "src" }
    object test extends ScalaJSTests with TestModule.Munit {
