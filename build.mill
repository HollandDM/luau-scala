import mill._, scalalib._, scalajslib._, scalafmt._
import mill.scalajslib.api.{ModuleKind, JsEnvConfig}

val scalaVersion       = "3.8.3"
val scalaJSVersion     = "1.21.0"
val munitVersion       = "1.2.0"

trait LuauCrossPlatformModule extends ScalaModule with ScalafmtModule {
  def scalaVersion = build.scalaVersion
  def mvnDeps = platformDeps
  def platformDeps: Seq[Dep] = Seq.empty
  def scalacOptions = super.scalacOptions() ++ Seq(
    "-encoding", "UTF-8",
    "-deprecation", "-feature", "-unchecked",
    "-Xkind-projector:underscores",
    "-source:future",
    // Required on stable releases for `import language.experimental.captureChecking`
    // (capture checking itself stays per-file opt-in via that import).
    "-experimental",
    // SIP-66 `into` modifier (LuaArg conversions at call sites) is a preview
    // feature on 3.8.
    "-preview"
  )
}

trait LuauCrossPlatformJSModule extends LuauCrossPlatformModule with ScalaJSModule {
  def scalaJSVersion = build.scalaJSVersion
  def moduleKind = ModuleKind.CommonJSModule
}

object core extends Module {
  // jvm and js compile the same shared sources (core/src, tests in
  // core/test/src); the two modules exist only to emit JVM and Scala.js
  // artifacts. Platform-specific code, if ever needed, gets its own dir.
  object jvm extends LuauCrossPlatformModule {
    override def sources = Task.Sources(moduleDir / os.up / "src")
    object test extends ScalaTests with TestModule.Munit {
      override def sources = Task.Sources(moduleDir / os.up / os.up / "test" / "src")
      def mvnDeps = Seq(mvn"org.scalameta::munit::${build.munitVersion}")
    }
  }
  object js extends LuauCrossPlatformJSModule {
    override def sources = Task.Sources(moduleDir / os.up / "src")
    object test extends ScalaJSTests with TestModule.Munit {
      override def sources = Task.Sources(moduleDir / os.up / os.up / "test" / "src")
      def mvnDeps = Seq(mvn"org.scalameta::munit::${build.munitVersion}")
    }
  }
}

object panama extends LuauCrossPlatformModule {
  override def moduleDeps = super.moduleDeps ++ Seq(core.jvm, stdlib.jvm)
  object test extends ScalaTests with TestModule.Munit {
    def mvnDeps = Seq(mvn"org.scalameta::munit::${build.munitVersion}")
    // stdlib.jvm.test provides PortedTaskSuiteBase
    override def moduleDeps = super.moduleDeps ++ Seq(core.jvm.test, stdlib.jvm.test)
    override def forkArgs = Task {
      val lib = shim.nativeBuild()
      Seq(
        "--enable-native-access=ALL-UNNAMED",
        "--enable-preview",
        s"-Dluau.shim.lib=${lib.path}"
      )
    }
    override def forkEnv = Task {
      super.forkEnv() ++ Map(
        "LUAU_CONFORMANCE_DIR" -> (shim.moduleDir / "luau" / "tests" / "conformance").toString,
        "LUAU_PORTED_DIR" -> (stdlib.moduleDir / "test" / "resources" / "ported").toString,
        // Luau's number lexing/printing goes through libc strtod/snprintf,
        // which honor LC_NUMERIC. A comma-decimal locale (vi_VN, de_DE, ...)
        // breaks parsing of literals like 3.14 inside the native Runtime.
        "LC_ALL" -> "C"
      )
    }
  }
}

object stdlib extends Module {
  object jvm extends LuauCrossPlatformModule {
    override def moduleDeps = super.moduleDeps ++ Seq(core.jvm, scheduler.jvm)
    override def sources = Task.Sources(moduleDir / os.up / "src", moduleDir / "src")
    object test extends ScalaTests with TestModule.Munit {
      override def sources = Task.Sources(moduleDir / os.up / os.up / "test" / "src")
      // scheduler.jvm.test provides TestBinding for StdlibSuite
      override def moduleDeps = super.moduleDeps ++ Seq(scheduler.jvm.test)
      def mvnDeps = Seq(mvn"org.scalameta::munit::${build.munitVersion}")
    }
  }
  object js extends LuauCrossPlatformJSModule {
    override def moduleDeps = super.moduleDeps ++ Seq(core.js, scheduler.js)
    override def sources = Task.Sources(moduleDir / os.up / "src", moduleDir / "src")
    object test extends ScalaJSTests with TestModule.Munit {
      override def sources = Task.Sources(moduleDir / os.up / os.up / "test" / "src")
      override def moduleDeps = super.moduleDeps ++ Seq(scheduler.js.test)
      def mvnDeps = Seq(mvn"org.scalameta::munit::${build.munitVersion}")
    }
  }
}

object scheduler extends Module {
  object jvm extends LuauCrossPlatformModule {
    override def moduleDeps = super.moduleDeps ++ Seq(core.jvm)
    override def sources = Task.Sources(moduleDir / os.up / "src", moduleDir / "src")
    object test extends ScalaTests with TestModule.Munit {
      override def sources = Task.Sources(moduleDir / os.up / os.up / "test" / "src")
      def mvnDeps = Seq(mvn"org.scalameta::munit::${build.munitVersion}")
    }
  }
  object js extends LuauCrossPlatformJSModule {
    override def moduleDeps = super.moduleDeps ++ Seq(core.js)
    override def sources = Task.Sources(moduleDir / os.up / "src", moduleDir / "src")
    object test extends ScalaJSTests with TestModule.Munit {
      override def sources = Task.Sources(moduleDir / os.up / os.up / "test" / "src")
      def mvnDeps = Seq(mvn"org.scalameta::munit::${build.munitVersion}")
    }
  }
}

object wasm extends LuauCrossPlatformJSModule {
  override def moduleDeps = super.moduleDeps ++ Seq(core.js, stdlib.js)
  override def jsEnvConfig = Task {
    val wasmDir = shim.wasmBuildNative()
    val wasmPath = wasmDir.path / "luau-shim.wasm"
    JsEnvConfig.NodeJs().copy(env = Map(
      "LUAU_WASM_PATH" -> wasmPath.toString,
      "LUAU_CONFORMANCE_DIR" -> (shim.moduleDir / "luau" / "tests" / "conformance").toString,
      "LUAU_PORTED_DIR" -> (stdlib.moduleDir / "test" / "resources" / "ported").toString
    ))
  }
  object test extends ScalaJSTests with TestModule.Munit {
    def mvnDeps = Seq(mvn"org.scalameta::munit::${build.munitVersion}")
    // stdlib.js.test provides PortedTaskSuiteBase
    override def moduleDeps = super.moduleDeps ++ Seq(core.js.test, stdlib.js.test)
  }
}

object shim extends Module {

  // Mill 1.x sandboxes os.pwd inside tasks; moduleDir is this module's real
  // source directory (<repo>/shim).
  def shimSrcDir    = Task { moduleDir }
  def shimIncDir    = Task { moduleDir / "include" }
  // Content-tracked shim sources: editing lx.cpp/lx.h must invalidate
  // nativeBuild, wasmShimObject, and wasmExceptionTag.
  def shimSources   = Task.Sources(
    moduleDir / "src",
    moduleDir / "include"
  )
  def luauIncVm     = Task { moduleDir / "luau" / "VM" / "include" }
  def luauIncCommon = Task { moduleDir / "luau" / "Common" / "include" }
  def luauIncCompiler = Task { moduleDir / "luau" / "Compiler" / "include" }
  def luauIncAst    = Task { moduleDir / "luau" / "Ast" / "include" }
  def luauIncBytecode = Task { moduleDir / "luau" / "Bytecode" / "include" }
  def luauVmDir     = Task { moduleDir / "luau" / "VM" }
  def luauCompilerDir = Task { moduleDir / "luau" / "Compiler" }
  def luauAstDir    = Task { moduleDir / "luau" / "Ast" }
  def luauBytecodeDir = Task { moduleDir / "luau" / "Bytecode" }
  def luauCommonDir = Task { moduleDir / "luau" / "Common" }

  def luauSubmoduleHead = Task.Input {
    val headFile = moduleDir / "luau" / ".git" / "HEAD"
    if (os.exists(headFile)) os.read(headFile).trim
    else "absent"
  }

  // Task.Input: listing the vendored submodule is an untracked read in Mill's
  // execution checker; Input tasks may read freely and re-evaluate per run.
  def luauSources = Task.Input {
    val dirs = Seq(
      moduleDir / "luau" / "VM",
      moduleDir / "luau" / "Compiler",
      moduleDir / "luau" / "Ast",
      moduleDir / "luau" / "Bytecode",
      moduleDir / "luau" / "Common"
    )
    dirs.flatMap { d =>
      val srcDir = d / "src"
      if (os.exists(srcDir)) os.list(srcDir).filter(_.ext == "cpp")
      else Seq.empty[os.Path]
    }
  }

  def allIncludeDirs = Task {
    Seq(
      shimIncDir().toString, luauIncVm().toString, luauIncCommon().toString,
      luauIncCompiler().toString, luauIncAst().toString, luauIncBytecode().toString
    )
  }

  def nativePlatform = Task {
    val _     = luauSubmoduleHead()
    val osStr = System.getProperty("os.name", "").toLowerCase
    if (osStr.contains("mac")) ("dylib", Seq("-dynamiclib"))
    else                        ("so",    Seq("-shared", "-fPIC"))
  }

  def nativeBuild = Task {
    val _           = shimSources()
    val dest        = Task.dest
    val (ext, lflags) = nativePlatform()
    val outLib      = dest / s"libluau-shim.$ext"
    val srcFile     = shimSrcDir() / "src" / "lx.cpp"
    val includeArgs = allIncludeDirs().flatMap(d => Seq("-I", d))
    val luauSrcs    = luauSources().map(_.toString)

    os.proc(Seq("clang++") ++
      Seq("-std=c++17", "-O2") ++ includeArgs ++ lflags ++
      Seq("-o", outLib.toString, srcFile.toString) ++ luauSrcs
    ).call(cwd = dest, stdout = os.Inherit, stderr = os.Inherit)

    PathRef(outLib)
  }

  /** WASI sysroot WITH C++ exceptions (libc++/libc++abi/libunwind), built
    * from wasi-sdk sources entirely inside the task sandbox.
    *
    * Why this exists: released wasi-sdk artifacts ship a -fno-exceptions
    * sysroot (no __cxa_throw / no libunwind), so Luau's exception-based error
    * model aborts. We rebuild only the sysroot — not LLVM, the system clang
    * is reused — against the wasi-sdk-31 sources (LLVM 22; keep the tag
    * matched to the system clang major), with -DWASI_SDK_EXCEPTIONS=ON.
    *
    * Requires: system clang/clang++ (LLVM >= 21 for new EH), cmake, ninja,
    * git. Scratch clone and ninja build live under dest/work; only dest/out
    * (sysroot + merged clang resource dir) is returned. quick = true:
    * content-hashing the llvm clone would stat-walk ~100k files on every
    * evaluation. The wasm compile/link tasks below consume the two output
    * dirs — they must take wasiSysroot()'s PathRef directly so a sysroot
    * content change invalidates them.
    */
  def wasiSysroot = Task {
    val dest   = Task.dest
    val out    = dest / "out"
    val work   = dest / "work" / "wasi-sdk"
    val prefix = out / "install"
    val rd     = out / "resource-dir"
    val tag    = "wasi-sdk-31"
    val clang  = "/usr/bin/clang"

    os.proc(
      "git", "clone", "--depth", "1", "-b", tag,
      "https://github.com/WebAssembly/wasi-sdk.git", work.toString
    ).call(cwd = dest, stdout = os.Inherit, stderr = os.Inherit)
    os.proc(
      "git", "submodule", "update", "--init", "--depth", "1",
      "src/wasi-libc", "src/config", "src/llvm-project"
    ).call(cwd = work, stdout = os.Inherit, stderr = os.Inherit)

    os.proc(
      "cmake", "-G", "Ninja", "-B", "build/sysroot", "-S", ".",
      s"-DCMAKE_TOOLCHAIN_FILE=${work / "wasi-sdk-p1.cmake"}",
      "-DWASI_SDK_PREFIX=/usr",
      "-DWASI_SDK_TARGETS=wasm32-wasi",
      // CI installs upstream LLVM which doesn't have wasi-sdk's fork-only
      // 'lime1' CPU target — pin to generic (safe baseline for all finished
      // wasm proposals: reference-types, bulk-memory, SIMD, etc).
      "-DWASI_SDK_CPU_CFLAGS=-mcpu=generic",
      // The wasm32-wasi compiler can't link host test binaries during cmake's
      // probe; the sysroot sources are trusted to compile.
      "-DCMAKE_C_COMPILER_WORKS=ON", "-DCMAKE_CXX_COMPILER_WORKS=ON",
      "-DWASI_SDK_EXCEPTIONS=ON",
      "-DWASI_SDK_INCLUDE_TESTS=OFF",
      s"-DCMAKE_INSTALL_PREFIX=$prefix"
    ).call(cwd = work, stdout = os.Inherit, stderr = os.Inherit)
    os.proc("ninja", "-C", "build/sysroot", "install")
      .call(cwd = work, stdout = os.Inherit, stderr = os.Inherit)

    // Merge clang resource dir: system clang headers + the wasm compiler-rt
    // builtins the sysroot build produced.
    val systemRd = os.Path(os.proc(clang, "-print-resource-dir").call().out.trim())
    os.makeDir.all(rd)
    os.symlink(rd / "include", systemRd / "include")
    os.symlink(rd / "lib", prefix / "clang-resource-dir" / "lib")

    PathRef(out, quick = true)
  }

  // ---- WASM build (system clang + wasiSysroot, no emscripten) ------------

  val wasmClang = "/usr/bin/clang++"

  /** Flags shared by every wasm compile AND the link: -fwasm-exceptions with
    * new EH (-wasm-use-legacy-eh=false) must be uniform across all objects —
    * mixing EH encodings breaks linking/unwinding, so do NOT special-case
    * any module. -mnontrapping-fptoint: out-of-range float->int casts must
    * wrap/saturate like native C, not trap (bit32 and number coercions rely
    * on it; i32.trunc_f64 traps on overflow).
    */
  def wasmCommonFlags(sysroot: os.Path): Seq[String] = Seq(
    "--target=wasm32-wasi",
    s"--sysroot=${sysroot / "install" / "share" / "wasi-sysroot"}",
    "-resource-dir", (sysroot / "resource-dir").toString,
    "-std=c++17",
    "-O2",
    "-fwasm-exceptions",
    "-mllvm", "-wasm-use-legacy-eh=false",
    "-mnontrapping-fptoint",
    "-fno-rtti"
  )

  private def compileWasmObject(dest: os.Path, flags: Seq[String], src: os.Path): os.Path = {
    val obj = dest / s"${src.last}.o"
    os.proc(Seq(wasmClang) ++ flags ++ Seq("-c", "-o", obj.toString, src.toString))
      .call(cwd = dest, stdout = os.Inherit, stderr = os.Inherit)
    obj
  }

  private def wasmCompileFlags(sysroot: os.Path, includes: Seq[String]): Seq[String] =
    wasmCommonFlags(sysroot) ++ Seq(
      "-D_LUAU_HAS_VECTOR_SIZE=0",
      "-D_WASI_EMULATED_PROCESS_CLOCKS"
    ) ++ includes.flatMap(d => Seq("-I", d))

  /** Luau library translation units -> wasm objects. Rarely invalidated
    * (vendored submodule + sysroot), so shim edits never recompile these.
    */
  def wasmLuauObjects = Task {
    val _     = luauSubmoduleHead()
    val flags = wasmCompileFlags(wasiSysroot().path, allIncludeDirs())
    luauSources().map(src => PathRef(compileWasmObject(Task.dest, flags, src)))
  }

  def wasmShimObject = Task {
    val _     = shimSources()
    val flags = wasmCompileFlags(wasiSysroot().path, allIncludeDirs())
    PathRef(compileWasmObject(Task.dest, flags, shimSrcDir() / "src" / "lx.cpp"))
  }

  /** Canonical __cpp_exception tag definition (plain asm — no sysroot or
    * C++ flags, just the wasm target + builtins).
    */
  def wasmExceptionTag = Task {
    val _   = shimSources()
    val rd  = wasiSysroot().path / "resource-dir"
    val obj = Task.dest / "cpp_exception_tag.o"
    os.proc(
      wasmClang, "--target=wasm32-wasi", "-resource-dir", rd.toString,
      "-c", "-o", obj.toString,
      (shimSrcDir() / "src" / "cpp_exception_tag.s").toString
    ).call(cwd = Task.dest, stdout = os.Inherit, stderr = os.Inherit)
    PathRef(obj)
  }

  /** The exported lx_* surface. Adding a shim export = add the symbol here
    * and in lx.h/lx.cpp; only wasmShimObject + the link rerun, the Luau
    * objects stay cached.
    */
  def wasmExports: Seq[String] = Seq(
    "lx_newstate", "lx_close", "lx_new_thread",
    "lx_thread_status", "lx_to_thread", "lx_reset_thread",
    "lx_compile_and_load", "lx_resume",
    "lx_push_nil", "lx_push_boolean", "lx_push_number", "lx_push_integer",
    "lx_push_lstring", "lx_push_ref", "lx_push_copy", "lx_pop", "lx_stack_top",
    "lx_type", "lx_to_number", "lx_to_integer", "lx_to_boolean", "lx_to_lstring",
    "lx_rawlen", "lx_newtable", "lx_rawget", "lx_rawset", "lx_rawgeti", "lx_rawseti",
    "lx_setarray", "lx_table_next", "lx_ref", "lx_unref", "lx_register_native",
    "lx_set_suspend_token", "lx_get_suspend_token",
    "lx_set_global", "lx_get_global",
    "lx_openlibs", "lx_sandbox",
    "lx_gc_step", "lx_gc_collect", "lx_copy_error", "lx_conformance_setup",
    "lx_resume_error",
    "malloc", "free"
  )

  def wasmBuildNative = Task {
    val sysroot = wasiSysroot().path
    val out     = Task.dest / "luau-shim.wasm"
    val ldflags = wasmCommonFlags(sysroot) ++ Seq(
      "-mexec-model=reactor",
      "-lc++abi",
      "-lunwind",
      "-lwasi-emulated-process-clocks"
    ) ++ wasmExports.map(e => s"-Wl,--export=$e") ++ Seq(
      "-Wl,--export-table",
      "-Wl,--growable-table",
      "-Wl,-z,stack-size=1048576",
      // buffers.luau allocates a full 1GiB buffer (bitops stress); growth is
      // on-demand, so the cap only needs to be high enough. wasm32 max: 4GiB.
      "-Wl,--max-memory=4294967296"
    )
    val objs = (wasmLuauObjects() :+ wasmShimObject() :+ wasmExceptionTag())
      .map(_.path.toString)
    os.proc(Seq(wasmClang) ++ ldflags ++ Seq("-o", out.toString) ++ objs)
      .call(cwd = Task.dest, stdout = os.Inherit, stderr = os.Inherit)
    PathRef(Task.dest)
  }
}
